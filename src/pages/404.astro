---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist or may have moved.">
  <section class="bg-navy-800 py-24 sm:py-32">
    <div class="container-page text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">404</span>
      <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        We couldn&rsquo;t find that page.
      </h1>
      <p class="mt-4 max-w-xl mx-auto text-base text-slate-300">
        The page you&rsquo;re looking for doesn&rsquo;t exist, may have moved, or the link might be outdated.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        {links.map((link) => (
          <a
            href={url(link.href)}
            class="inline-flex items-center gap-2 rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
