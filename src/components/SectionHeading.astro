---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : '', className]}>
  {eyebrow && (
    <span class="text-xs font-semibold uppercase tracking-wider text-amber-600">{eyebrow}</span>
  )}
  <h2 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-ink-800">{title}</h2>
  {description && <p class="mt-3 text-base leading-relaxed text-slate-600">{description}</p>}
</div>
