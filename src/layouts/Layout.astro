---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import company from '../data/company.json';
import ogImageSource from '../assets/images/og-image.png';
import logoSource from '../assets/images/logo-nka-consult-wide.png';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'NKA Consult: Engineering and Management Consultants based in Accra, Ghana, delivering infrastructure, construction supervision, and consulting services since 2002.',
} = Astro.props;

const pageTitle = title === 'NKA Consult' ? title : `${title} · NKA Consult`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const ogImage = await getImage({ src: ogImageSource, width: 1200, height: 630, format: 'png' });
const ogImageURL = new URL(ogImage.src, Astro.site);

const logoImage = await getImage({ src: logoSource, width: logoSource.width, format: 'png' });
const logoImageURL = new URL(logoImage.src, Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'GeneralContractor'],
  name: company.name,
  alternateName: company.tagline,
  url: Astro.site?.toString(),
  logo: logoImageURL.toString(),
  image: ogImageURL.toString(),
  description,
  foundingDate: String(company.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.contact.headOffice.address,
    addressLocality: 'Accra',
    addressCountry: 'GH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 5.5809575,
    longitude: -0.1947088,
  },
  areaServed: ['Ghana', 'West Africa'],
  telephone: company.contact.phone,
  email: company.contact.emails[0],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NKA Consult" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
