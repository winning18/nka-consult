---
import { url } from '../lib/url';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(url(item.href), Astro.site).toString() } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="bg-paper-50 border-b border-slate-200">
  <div class="container-page py-2.5">
    <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
      {items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span class="text-slate-300">/</span>}
          {item.href && i < items.length - 1 ? (
            <a href={url(item.href)} class="hover:text-navy-800 transition-colors">{item.label}</a>
          ) : (
            <span class="text-ink-800 font-medium truncate max-w-[220px] sm:max-w-none">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
