---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { getImage, hasImage } from '../lib/images';
import company from '../data/company.json';
import certificationsData from '../data/certifications.json';
import type { Certification } from '../lib/types';

const certifications = (certificationsData as Certification[]).filter((c) => hasImage(c.file));
---

<Layout title="Credentials" description="NKA Consult's legal registration, tax and procurement certificates, and office facilities.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Credentials' }]} />
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Credentials</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Registered, certified, and equipped to deliver.
      </h1>
      <p class="mt-4 max-w-2xl text-base text-slate-300">{company.legalStatus}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Legal & tax registration" title="Company Registration Certificates" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {certifications.map((cert) => (
          <figure class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-[var(--shadow-card)]">
            <Image src={getImage(cert.file)} alt={cert.title} width={640} class="w-full object-contain bg-paper-100" />
            <figcaption class="p-4">
              <p class="text-sm font-semibold text-ink-800">{cert.title}</p>
              <p class="mt-0.5 text-xs text-slate-500">{cert.detail}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white border-y border-slate-200">
    <div class="container-page">
      <SectionHeading eyebrow="Head office" title="Office Location" />
      <address class="mt-4 not-italic text-sm leading-relaxed text-slate-600 space-y-1">
        <p class="font-medium text-ink-800">{company.contact.headOffice.label}</p>
        <p>{company.contact.headOffice.address}</p>
        <p>GPS Address: {company.contact.headOffice.gpsAddress}</p>
      </address>

      <div class="mt-8 aspect-[16/9] w-full overflow-hidden rounded-lg border border-slate-200">
        <iframe
          src="https://www.google.com/maps?q=5.5809575,-0.1947088&z=16&output=embed"
          title="NKA Consult office location on Google Maps"
          class="h-full w-full"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <CTASection title="Need our services? get in touch" />
</Layout>
