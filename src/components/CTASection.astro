---
interface Props {
  title: string;
  description?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  title,
  description,
  buttonLabel = 'Get in touch',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="bg-navy-800">
  <div class="container-page py-16 sm:py-20 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white max-w-2xl mx-auto">{title}</h2>
    {description && <p class="mt-4 text-base text-navy-200/90 max-w-xl mx-auto text-slate-200">{description}</p>}
    <a
      href={buttonHref}
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-amber-500 px-6 py-3 text-sm font-semibold text-ink-900 transition-colors hover:bg-amber-400"
    >
      {buttonLabel}
    </a>
  </div>
</section>
