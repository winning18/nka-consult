---
import { url } from '../lib/url';

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/team', label: 'Our People' },
  { href: '/clients-donors', label: 'Clients' },
  { href: '/credentials', label: 'Credentials' },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  const target = url(href);
  return href === '/' ? currentPath === target : currentPath.startsWith(target);
}
---

<header class="sticky top-0 z-50 bg-paper-50/90 backdrop-blur border-b border-slate-200">
  <div class="container-page flex items-center justify-between h-18 py-3">
    <a href={url('/')} class="flex items-center gap-2.5 group">
      <span class="flex h-10 w-10 items-center justify-center rounded-md bg-navy-800 text-white font-bold text-lg tracking-tight">
        NK
      </span>
      <span class="leading-tight">
        <span class="block font-bold text-ink-800 text-[15px] tracking-tight">NKA Consult</span>
        <span class="block text-[11px] uppercase tracking-wider text-slate-500">Engineers and Project Managers</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={url(link.href)}
          class:list={[
            'px-3 py-2 text-sm font-medium rounded transition-colors',
            isActive(link.href)
              ? 'text-navy-800 bg-navy-800/[0.06]'
              : 'text-slate-600 hover:text-navy-800 hover:bg-navy-800/[0.04]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <a
        href={url('/contact')}
        class="inline-flex items-center gap-1.5 rounded-md bg-navy-800 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-navy-700"
      >
        Contact Us
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      class="lg:hidden flex h-10 w-10 items-center justify-center rounded-md text-ink-800 hover:bg-navy-800/[0.06]"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-paper-50">
    <div class="container-page py-3 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={url(link.href)}
          class:list={[
            'px-3 py-2.5 text-sm font-medium rounded',
            isActive(link.href) ? 'text-navy-800 bg-navy-800/[0.06]' : 'text-slate-600',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={url('/contact')} class="mt-2 inline-flex items-center justify-center rounded-md bg-navy-800 px-4 py-2.5 text-sm font-semibold text-white">
        Contact Us
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });
</script>
