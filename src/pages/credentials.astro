---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { getImage, hasImage } from '../lib/images';
import company from '../data/company.json';
import certificationsData from '../data/certifications.json';
import officeData from '../data/office.json';
import type { Certification, OfficePhoto } from '../lib/types';

const certifications = (certificationsData as Certification[]).filter((c) => hasImage(c.file));
const office = officeData as { officeSetup: OfficePhoto[]; projectVehicles: OfficePhoto[]; fieldEquipment: OfficePhoto[] };

const officeSetup = office.officeSetup.filter((p) => hasImage(p.file));
const projectVehicles = office.projectVehicles.filter((p) => hasImage(p.file));
const fieldEquipment = office.fieldEquipment.filter((p) => hasImage(p.file));
---

<Layout title="Credentials" description="NKA Consult's legal registration, tax and procurement certificates, office facilities, and field equipment.">
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Credentials</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Registered, certified, and equipped to deliver.
      </h1>
      <p class="mt-4 max-w-2xl text-base text-slate-300">{company.legalStatus}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Legal & tax registration" title="Company Registration Certificates" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {certifications.map((cert) => (
          <figure class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-[var(--shadow-card)]">
            <Image src={getImage(cert.file)} alt={cert.title} width={640} class="w-full object-contain bg-paper-100" />
            <figcaption class="p-4">
              <p class="text-sm font-semibold text-ink-800">{cert.title}</p>
              <p class="mt-0.5 text-xs text-slate-500">{cert.detail}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white border-y border-slate-200">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Head office" title="Office Location" />
        <address class="mt-4 not-italic text-sm leading-relaxed text-slate-600 space-y-1">
          <p class="font-medium text-ink-800">{company.contact.headOffice.label}</p>
          <p>{company.contact.headOffice.address}</p>
          <p>GPS Address: {company.contact.headOffice.gpsAddress}</p>
        </address>
      </div>
      {officeSetup.length > 0 && (
        <div class="grid grid-cols-2 gap-3">
          {officeSetup.map((photo) => (
            <Image src={getImage(photo.file)} alt={photo.caption} width={280} height={200} class="rounded-lg object-cover w-full h-full" />
          ))}
        </div>
      )}
    </div>
  </section>

  {(projectVehicles.length > 0 || fieldEquipment.length > 0) && (
    <section class="py-16 sm:py-20">
      <div class="container-page space-y-14">
        {projectVehicles.length > 0 && (
          <div>
            <SectionHeading eyebrow="Fleet" title="Project Vehicles" />
            <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4">
              {projectVehicles.map((photo) => (
                <Image src={getImage(photo.file)} alt={photo.caption} width={280} height={200} class="rounded-lg object-cover w-full aspect-[4/3]" />
              ))}
            </div>
          </div>
        )}
        {fieldEquipment.length > 0 && (
          <div>
            <SectionHeading eyebrow="Instrumentation" title="Field Equipment" />
            <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4">
              {fieldEquipment.map((photo) => (
                <figure>
                  <Image src={getImage(photo.file)} alt={photo.caption} width={280} height={200} class="rounded-lg object-cover w-full aspect-[4/3]" />
                  <figcaption class="mt-1.5 text-xs text-slate-500">{photo.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <CTASection title="Need our credentials for a tender submission?" description="Request our full company profile, CVs, and certificates for your procurement process." />
</Layout>
