---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { url } from '../lib/url';
import company from '../data/company.json';
---

<Layout title="About Us" description="Learn about NKA Consult's history, vision, mission, core values, and organizational structure.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">About Us</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        A consultancy built on engineering rigor and trust.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-300">{company.overview}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page grid gap-8 sm:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-[var(--shadow-card)]">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-amber-600">Our Vision</h2>
        <p class="mt-3 text-lg font-medium leading-relaxed text-ink-800">{company.vision}</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-[var(--shadow-card)]">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-amber-600">Our Mission</h2>
        <p class="mt-3 text-lg font-medium leading-relaxed text-ink-800">{company.mission}</p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white border-y border-slate-200">
    <div class="container-page">
      <SectionHeading eyebrow="What guides us" title="Our Core Values" align="center" class="mx-auto" />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {company.coreValues.map((value) => (
          <div class="rounded-lg border border-slate-200 p-6">
            <h3 class="font-bold text-ink-800">{value.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Structure" title="Organization" />
        <p class="mt-4 text-sm leading-relaxed text-slate-600">{company.organization}</p>
        <p class="mt-4 text-sm font-medium text-ink-800">We specialize in:</p>
        <ul class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 list-disc pl-5 marker:text-amber-500 text-sm text-slate-600">
          {company.specializations.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <SectionHeading eyebrow="How we deliver" title="Project Execution & Quality Assurance" />
        <p class="mt-4 text-sm leading-relaxed text-slate-600">{company.projectExecution}</p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white border-y border-slate-200">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading title="Track Records" />
        <p class="mt-4 text-sm leading-relaxed text-slate-600">{company.coreCompetencies}</p>
      </div>
      <div>
        <SectionHeading eyebrow="Compliance" title="Legal Status" />
        <p class="mt-4 text-sm leading-relaxed text-slate-600">{company.legalStatus}</p>
        <a href={url('/credentials')} class="mt-4 inline-block text-sm font-semibold text-navy-800 hover:text-navy-700">
          View registration certificates &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Our people" title="Core team disciplines" align="center" class="mx-auto" />
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {company.coreTeamDisciplines.map((d) => (
          <span class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-ink-800">{d}</span>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href={url('/team')} class="text-sm font-semibold text-navy-800 hover:text-navy-700">Meet our leadership &rarr;</a>
      </div>
    </div>
  </section>

  <CTASection title="Need our services? get in touch" />
</Layout>
