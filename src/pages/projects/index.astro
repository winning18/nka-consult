---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import projectsData from '../../data/projects.json';
import type { Project } from '../../lib/types';

const projects = projectsData as Project[];

const categories = Array.from(
  new Map(projects.map((p) => [p.category, p.categoryLabel])).entries()
).map(([value, label]) => ({ value, label }));
---

<Layout title="Projects" description="Browse NKA Consult's portfolio of road, building, port, health, agricultural, and water & sanitation infrastructure projects.">
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Projects</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        {projects.length}+ projects across roads, ports, health, water, and public infrastructure.
      </h1>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-page">
      <div id="filter-bar" class="flex flex-wrap gap-2">
        <button data-filter="all" class="filter-btn is-active rounded-full border border-navy-800 bg-navy-800 px-4 py-1.5 text-xs font-semibold text-white">
          All ({projects.length})
        </button>
        {categories.map((cat) => {
          const count = projects.filter((p) => p.category === cat.value).length;
          return (
            <button
              data-filter={cat.value}
              class="filter-btn rounded-full border border-slate-300 bg-white px-4 py-1.5 text-xs font-semibold text-slate-600 hover:border-navy-800"
            >
              {cat.label} ({count})
            </button>
          );
        })}
      </div>

      <div id="project-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <div class="project-item" data-category={project.category}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>

      <p id="empty-state" class="hidden mt-10 text-center text-sm text-slate-500">
        No projects found in this category.
      </p>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const emptyState = document.getElementById('empty-state');

  function applyFilter(filter: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const match = filter === 'all' || item.dataset.category === filter;
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    emptyState?.classList.toggle('hidden', visibleCount !== 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('is-active', 'bg-navy-800', 'text-white', 'border-navy-800');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-300');
      });
      btn.classList.add('is-active', 'bg-navy-800', 'text-white', 'border-navy-800');
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-300');
      applyFilter(btn.dataset.filter ?? 'all');
      const url = new URL(window.location.href);
      if (btn.dataset.filter === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', btn.dataset.filter ?? '');
      }
      window.history.replaceState({}, '', url);
    });
  });

  const initial = new URLSearchParams(window.location.search).get('category');
  if (initial) {
    const match = document.querySelector<HTMLButtonElement>(`.filter-btn[data-filter="${initial}"]`);
    match?.click();
  }
</script>
