---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { getImage, hasImage } from '../lib/images';
import clientsData from '../data/clients.json';
import donorsData from '../data/donors.json';
import type { ClientLogo, Donor } from '../lib/types';

const clients = (clientsData as ClientLogo[]).filter((c) => hasImage(c.file));
const donors = donorsData as Donor[];
---

<Layout title="Clients & Donors" description="Government agencies, private developers, and international development partners NKA Consult has worked with.">
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Clients &amp; Donors</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Trusted by government, private developers, and international donors.
      </h1>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Some of our clients" title="Government agencies & private partners" />
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5">
        {clients.map((client) => (
          <div class="flex flex-col items-center justify-center gap-3 rounded-lg border border-slate-200 bg-white p-5 text-center">
            <Image src={getImage(client.file)} alt={client.name} width={280} class="max-h-14 w-auto object-contain" />
            <span class="text-xs font-medium text-slate-600">{client.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white border-t border-slate-200">
    <div class="container-page">
      <SectionHeading eyebrow="Donor funded programmes" title="Our Donor Experience" description="NKA Consult has delivered projects funded and coordinated with major international development agencies." />
      <div class="mt-10 overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full min-w-[640px] border-collapse text-sm">
          <thead>
            <tr class="bg-paper-100 text-left">
              <th class="px-5 py-3.5 font-semibold text-ink-800 w-1/4">Donor Agency</th>
              <th class="px-5 py-3.5 font-semibold text-ink-800 w-1/6">Role</th>
              <th class="px-5 py-3.5 font-semibold text-ink-800">Projects</th>
            </tr>
          </thead>
          <tbody>
            {donors.map((donor, i) => (
              <tr class:list={[i % 2 === 0 ? 'bg-white' : 'bg-paper-50', 'border-t border-slate-200 align-top']}>
                <td class="px-5 py-4 font-medium text-ink-800">{donor.agency}</td>
                <td class="px-5 py-4 text-slate-600">{donor.role}</td>
                <td class="px-5 py-4 text-slate-600">
                  {donor.projects.length === 1 ? (
                    <p>{donor.projects[0]}</p>
                  ) : (
                    <ul class="list-disc pl-4 space-y-1">
                      {donor.projects.map((proj) => <li>{proj}</li>)}
                    </ul>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTASection title="Need our services? get in touch" />
</Layout>
