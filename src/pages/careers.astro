---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout title="Careers" description="Career opportunities at NKA Consult.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Careers' }]} />
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Careers</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Build your career with NKA Consult.
      </h1>
      <p class="mt-4 max-w-2xl text-base text-slate-300">
        Current openings and opportunities to join our team of engineers and consultants.
      </p>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-md text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-navy-800/[0.08] text-navy-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </div>
        <h2 class="mt-4 text-lg font-bold text-ink-800">No open positions right now</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          We don't have any vacancies listed at the moment. Check back soon, or send us your CV for future consideration.
        </p>
      </div>
    </div>
  </section>

  <CTASection title="Need our services? get in touch" />
</Layout>
