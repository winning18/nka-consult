---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import { url } from '../lib/url';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Newsroom" description="Company news, announcements, and updates from NKA Consult.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Newsroom' }]} />
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Newsroom</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        News and updates from NKA Consult.
      </h1>
      <p class="mt-4 max-w-2xl text-base text-slate-300">
        Announcements, project milestones, and company news.
      </p>
    </div>
  </section>

  {posts.length === 0 ? (
    <section class="py-20 sm:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-md text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-navy-800/[0.08] text-navy-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m5.231 13.481L15 17.25m-1.519-1.71a4.5 4.5 0 10-2.019 2.019m-2.019-2.019L3.75 21m6.181-9L14.25 8.25" />
            </svg>
          </div>
          <h2 class="mt-4 text-lg font-bold text-ink-800">No news posted yet</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Check back soon for updates from NKA Consult, or get in touch if you have a press or media enquiry.
          </p>
        </div>
      </div>
    </section>
  ) : (
    <section class="py-16 sm:py-20">
      <div class="container-page grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={url(`/newsroom/${post.id}`)}
            class="flex flex-col rounded-lg border border-slate-200 bg-white p-6 shadow-[var(--shadow-card)] transition-shadow hover:shadow-[var(--shadow-card-hover)]"
          >
            <time class="text-xs font-semibold uppercase tracking-wider text-amber-600" datetime={post.data.date.toISOString()}>
              {dateFormatter.format(post.data.date)}
            </time>
            <h2 class="mt-2 text-base font-semibold leading-snug text-ink-800">{post.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{post.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <CTASection title="Need our services? get in touch" />
</Layout>
