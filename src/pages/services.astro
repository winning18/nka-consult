---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { url } from '../lib/url';
import company from '../data/company.json';
import projectsData from '../data/projects.json';
import type { Project } from '../lib/types';

const projects = projectsData as Project[];

const serviceDetails = [
  {
    title: 'Project Cycle Management',
    description: 'Design, Procurement, Supervision, Appraisal, Monitoring and Evaluation across the full lifecycle of infrastructure projects.',
  },
  {
    title: 'Civil and Structural Engineering',
    description: 'Structural design, review, and construction supervision for roads, bridges, buildings, and marine infrastructure.',
  },
  {
    title: 'Urban Development and Management',
    description: 'Planning and delivery of urban infrastructure, including markets, transport terminals, drainage, and public facilities.',
  },
  {
    title: 'Training and Capacity Building',
    description: 'Training programmes for contractors, client staff, and institutions on contract management, procurement, and technical delivery.',
  },
  {
    title: 'Safeguards Management',
    description: 'Traffic, transport, environmental and social safeguards, including resettlement impact assessment and management.',
  },
  {
    title: 'Road Safety, Traffic & Transportation Engineering',
    description: 'Traffic data collection, road safety audits, transportation planning, and traffic management scheme design.',
  },
  {
    title: 'Management Consulting',
    description: 'Institutional strengthening, procurement audits, contract management reviews, and organizational development advisory.',
  },
];

const categoryCounts = projects.reduce<Record<string, { label: string; count: number }>>((acc, p) => {
  acc[p.category] = acc[p.category] ?? { label: p.categoryLabel, count: 0 };
  acc[p.category].count += 1;
  return acc;
}, {});
---

<Layout title="Services" description="NKA Consult's core service areas: project cycle management, civil and structural engineering, urban development, training, safeguards, road safety, and management consulting.">
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Services</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Engineering and consulting services across the full project lifecycle.
      </h1>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page grid gap-6 sm:grid-cols-2">
      {serviceDetails.map((service) => (
        <div class="rounded-lg border border-slate-200 bg-white p-7 shadow-[var(--shadow-card)]">
          <h2 class="text-lg font-bold text-ink-800">{service.title}</h2>
          <p class="mt-2.5 text-sm leading-relaxed text-slate-600">{service.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white border-y border-slate-200">
    <div class="container-page">
      <SectionHeading eyebrow="Delivered across sectors" title="Project experience by sector" align="center" class="mx-auto" />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {Object.entries(categoryCounts).map(([key, val]) => (
          <a href={url(`/projects?category=${key}`)} class="rounded-lg border border-slate-200 bg-paper-50 p-6 hover:border-navy-800/40 transition-colors">
            <p class="text-3xl font-extrabold text-navy-800">{val.count}</p>
            <p class="mt-1 text-sm font-medium text-ink-800">{val.label}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Looking for a specific capability?" description="Get in touch and we'll walk you through the relevant service area and past project examples." />
</Layout>
