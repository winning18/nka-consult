---
import Layout from '../layouts/Layout.astro';
import company from '../data/company.json';
---

<Layout title="Contact" description="Get in touch with NKA Consult, Accra, Ghana. Engineers and Management Consultants.">
  <section class="bg-navy-800 py-16 sm:py-20">
    <div class="container-page">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Contact</span>
      <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Let&rsquo;s talk about your project.
      </h1>
      <p class="mt-4 max-w-2xl text-base text-slate-300">
        Reach out to our team in Accra for enquiries, tender submissions, or partnership discussions.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2 space-y-8">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Head Office</h2>
          <address class="mt-3 not-italic text-base leading-relaxed text-ink-800 space-y-1">
            <p class="font-semibold">{company.contact.headOffice.label}</p>
            <p>{company.contact.headOffice.address}</p>
            <p class="text-sm text-slate-500">GPS Address: {company.contact.headOffice.gpsAddress}</p>
          </address>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Postal Address</h2>
          <p class="mt-3 text-base text-ink-800">{company.contact.poBox}</p>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Phone</h2>
          <p class="mt-3 text-base text-ink-800">
            <a href={`tel:${company.contact.phone.replace(/\s/g, '')}`} class="hover:text-navy-800">{company.contact.phone}</a>
          </p>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Email</h2>
          <div class="mt-3 space-y-1">
            {company.contact.emails.map((email) => (
              <p><a href={`mailto:${email}`} class="text-base text-navy-800 hover:text-navy-700 break-all">{email}</a></p>
            ))}
          </div>
        </div>
      </div>

      <div class="lg:col-span-3">
        <form
          class="rounded-lg border border-slate-200 bg-white p-8 shadow-[var(--shadow-card)] space-y-5"
          data-contact-form
          action={`https://formsubmit.co/ajax/${company.contact.emails[0]}`}
          method="POST"
        >
          <input type="hidden" name="_subject" value="New enquiry from the NKA Consult website" />
          <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-ink-800">Full name</label>
              <input id="name" name="name" type="text" required class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm focus:border-navy-800 focus:outline-none focus:ring-1 focus:ring-navy-800" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink-800">Email</label>
              <input id="email" name="email" type="email" required class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm focus:border-navy-800 focus:outline-none focus:ring-1 focus:ring-navy-800" />
            </div>
          </div>
          <div>
            <label for="organization" class="block text-sm font-medium text-ink-800">Organization (optional)</label>
            <input id="organization" name="organization" type="text" class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm focus:border-navy-800 focus:outline-none focus:ring-1 focus:ring-navy-800" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-ink-800">Message</label>
            <textarea id="message" name="message" rows="5" required class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm focus:border-navy-800 focus:outline-none focus:ring-1 focus:ring-navy-800"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-navy-800 px-6 py-3 text-sm font-semibold text-white hover:bg-navy-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
            Send Message
          </button>
          <p data-form-status class="hidden text-sm"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLParagraphElement>('[data-form-status]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function showStatus(message: string, tone: 'success' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'text-amber-600', 'text-green-700');
    status.classList.add(tone === 'success' ? 'text-green-700' : 'text-amber-600');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    if (submitButton) submitButton.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        showStatus("Thanks — your message has been sent. We'll be in touch shortly.", 'success');
        form.reset();
      } else {
        showStatus('Something went wrong sending your message. Please email us directly instead.', 'error');
      }
    } catch {
      showStatus('Something went wrong sending your message. Please email us directly instead.', 'error');
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
